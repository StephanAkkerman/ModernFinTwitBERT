{
    "mode": "finetune",
    "base_args": {
        "bf16": true,
        "load_best_model_at_end": true,
        "optim": "adamw_torch_fused",
        "eval_strategy": "epoch",
        "save_strategy": "epoch",
        "report_to": "wandb"
    },
    "pretrain": {
        "model_name": "ModernFinTwitBERT",
        "base_model": "answerdotai/ModernBERT-base",
        "do_hyperopt": false,
        "pretrain_args": {
            "num_train_epochs": 2,
            "per_device_train_batch_size": 128,
            "per_device_eval_batch_size": 256,
            "learning_rate": 0.0001,
            "weight_decay": 0.01,
            "warmup_steps": 0.05,
            "eval_strategy": "steps",
            "save_strategy": "steps",
            "eval_steps": 5000,
            "save_steps": 5000,
            "logging_steps": 100,
            "save_total_limit": 2,
            "dataloader_num_workers": 4,
            "metric_for_best_model": "eval_loss",
            "greater_is_better": false
        },
        "mlm_probability": 0.3
    },
    "finetune": {
        "model_name": "ModernFinTwitBERT-sentiment",
        "base_model": "answerdotai/ModernBERT-base",
        "do_hyperopt": false,
        "hyperopt_trials": 20,
        "max_length": 128,
        "drop_sources": [
            "mattgilgo",
            "yash",
            "surge_crypto",
            "surge_stock"
        ],
        "finetune_args": {
            "num_train_epochs": 2,
            "per_device_train_batch_size": 32,
            "per_device_eval_batch_size": 128,
            "logging_steps": 50,
            "learning_rate": 5e-05,
            "metric_for_best_model": "f1",
            "greater_is_better": true,
            "warmup_steps": 0.1,
            "weight_decay": 0.01,
            "save_total_limit": 2
        }
    }
}
